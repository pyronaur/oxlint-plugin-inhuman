{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
	"jsPlugins": ["./oxlint/inhuman.plugin.js", "oxlint-plugin-complexity"],
	"ignorePatterns": ["**/node_modules/**"],
	"settings": {
		"inhuman": {
			"predicateNamePattern": "^(is|has|can|should|must|needs|will|keeps)[A-Z_]"
		}
	},
	"overrides": [
		{
			"files": ["oxlint/**/*.js", "scripts/**/*.mjs"],
			"rules": {
				"typescript/consistent-type-imports": [
					"error",
					{
						"fixStyle": "inline-type-imports"
					}
				],
				"typescript/no-import-type-side-effects": "error",
				"import/no-duplicates": "error",
				"import/no-self-import": "error",
				"eslint/no-unused-vars": [
					"error",
					{
						"args": "after-used",
						"vars": "all",
						"caughtErrors": "all",
						"fix": {
							"imports": "safe-fix",
							"variables": "suggestion"
						}
					}
				],
				"max-depth": ["error", { "max": 3 }],
				"max-params": ["error", { "max": 3 }],
				"max-lines": ["error", { "max": 500 }],
				"max-lines-per-function": ["error", { "max": 100 }],
				"max-statements": ["error", { "max": 32 }],
				"max-nested-callbacks": ["error", { "max": 3 }],
				"max-classes-per-file": ["error", { "max": 1, "ignoreExpressions": true }],
				"curly": ["error", "all"],
				"no-else-return": ["error", { "allowElseIf": false }],
				"inhuman/require-guard-clauses": "error",
				"inhuman/no-swallowed-catch": "error",
				"inhuman/export-code-last": "error",
				"inhuman/no-empty-wrappers": "error",
				"inhuman/no-local-property-alias": "error",
				"inhuman/no-switch": "error",
				"inhuman/no-else": "error",
				"oxc/no-barrel-file": "error",
				"typescript/no-unnecessary-type-constraint": "error",
				"typescript/no-useless-empty-export": "error",
				"eslint/no-unneeded-ternary": "error",
				"eslint/no-useless-concat": "error",
				"unicorn/prefer-array-flat-map": "error",
				"unicorn/no-abusive-eslint-disable": "error",
				"complexity/complexity": [
					"error",
					{
						"cyclomatic": 10,
						"cognitive": 10
					}
				],
				"typescript/no-wrapper-object-types": "error",
				"typescript/no-restricted-types": [
					"error",
					{
						"types": {
							"object": {
								"message": "Use a specific object shape. If the data is already typed, prefer generics. Reserve unknown as a last resort for incoming external data before validation."
							},
							"Object": {
								"message": "Use a specific object shape. If the data is already typed, prefer generics. Reserve unknown as a last resort for incoming external data before validation."
							},
							"Function": {
								"message": "Declare the callable signature explicitly."
							}
						}
					}
				],
				"typescript/consistent-type-assertions": [
					"error",
					{ "assertionStyle": "never" }
				],
				"typescript/no-non-null-assertion": "error",
				"typescript/no-unnecessary-type-assertion": "error",
				"typescript/no-unsafe-type-assertion": "error",
				"typescript/non-nullable-type-assertion-style": "error"
			}
		},
		{
			"files": ["examples/**/*.{js,ts}"],
			"rules": {
				"inhuman/require-guard-clauses": "error",
				"inhuman/no-swallowed-catch": "error",
				"inhuman/export-code-last": "error",
				"inhuman/no-empty-wrappers": "error",
				"inhuman/no-switch": "error",
				"inhuman/no-else": "error"
			}
		},
		{
			"files": [
				"examples/pass/no-single-use-local-function.js",
				"examples/fail/no-single-use-local-function.js"
			],
			"rules": {
				"inhuman/no-single-use-local-function": "error"
			}
		},
		{
			"files": [
				"examples/pass/no-local-property-alias.js",
				"examples/fail/no-local-property-alias.js"
			],
			"rules": {
				"inhuman/no-local-property-alias": "error"
			}
		},
		{
			"files": [
				"examples/pass/no-manual-validation.ts",
				"examples/fail/no-manual-validation-assertion.ts",
				"examples/fail/no-manual-validation-predicate.ts",
				"examples/fail/no-manual-validation-scalar-parser.ts"
			],
			"rules": {
				"inhuman/no-manual-validation": "error"
			}
		},
		{
			"files": [
				"examples/pass/no-caught-typebox-validation.ts",
				"examples/fail/no-caught-typebox-validation-alias.ts",
				"examples/fail/no-caught-typebox-validation-cause.ts",
				"examples/fail/no-caught-typebox-validation-direct.ts",
				"examples/fail/no-caught-typebox-validation-namespace.ts",
				"examples/fail/no-caught-typebox-validation-nested-expression.ts"
			],
			"rules": {
				"inhuman/no-caught-typebox-validation": "error"
			}
		},
		{
			"files": [
				"examples/pass/no-shell-polling-loops.js",
				"examples/fail/no-shell-polling-loops.js"
			],
			"rules": {
				"inhuman/no-shell-polling-loops": "error"
			}
		},
		{
			"files": [
				"examples/pass/max-function-size.js",
				"examples/fail/max-function-size.js"
			],
			"rules": {
				"inhuman/max-function-size": [
					"error",
					{
						"max-lines": 4,
						"scoped": [
							{
								"inside": ["describe", "suite", "test", "test.describe", "description"],
								"max-lines": 20
							}
						]
					}
				]
			}
		}
	]
}
