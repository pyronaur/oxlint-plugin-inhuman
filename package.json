{
	"name": "oxlint-plugin-inhuman",
	"version": "0.1.9",
	"private": false,
	"type": "module",
	"packageManager": "pnpm@11.1.1",
	"description": "Oxlint JS plugin for opinionated rules that steer AI and humans toward explicit, guard-clause-first, error-safe code.",
	"keywords": [
		"oxlint",
		"oxc",
		"eslint",
		"lint",
		"plugin",
		"ai",
		"guard-clauses",
		"error-handling"
	],
	"license": "MIT",
	"exports": {
		".": "./oxlint/inhuman.plugin.js",
		"./inhuman.plugin.js": "./oxlint/inhuman.plugin.js"
	},
	"files": [
		"oxlint",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"lint": "pnpm format && pnpm lint:oxlint:fix && pnpm jscpd && pnpm jscpd:examples && pnpm knip",
		"lint-dry": "pnpm format:check && pnpm lint:oxlint && pnpm jscpd && pnpm jscpd:examples && pnpm knip",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"lint:oxlint": "oxlint --type-aware oxlint scripts",
		"lint:oxlint:fix": "oxlint --fix --type-aware oxlint scripts",
		"jscpd": "jscpd --config .jscpd.json",
		"jscpd:examples": "jscpd --config .jscpd.tests.json",
		"knip": "knip --production",
		"test": "node scripts/test-fixtures.mjs"
	},
	"dependencies": {
		"oxlint-plugin-no-branching": "^0.1.2"
	},
	"devDependencies": {
		"dprint": "^0.54.0",
		"eslint": "^9.39.2",
		"jscpd": "^4.2.3",
		"knip": "^6.14.2",
		"oxlint": "^1.66.0",
		"oxlint-plugin-complexity": "^2.1.2",
		"oxlint-tsgolint": "^0.23.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pyronaur/oxlint-plugin-inhuman.git"
	},
	"author": "pyronaur",
	"bugs": {
		"url": "https://github.com/pyronaur/oxlint-plugin-inhuman/issues"
	},
	"homepage": "https://github.com/pyronaur/oxlint-plugin-inhuman#readme",
	"main": "./oxlint/inhuman.plugin.js"
}
